# این فایل را به .env (کنار docker-compose.yml) کپی و مقادیر را پر کنید:  cp .env.production.example .env
# هرگز .env را در گیت قرار ندهید.

DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com
APP_URL=https://example.com
APP_NAME=دامون

POSTGRES_USER=damoon
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=damoon

# openssl rand -hex 32
SESSION_SECRET=
OTP_PEPPER=

# ملی پیامک
MELIPAYAMAK_CONSOLE_KEY=
MELIPAYAMAK_BODY_ID=
MELIPAYAMAK_FROM=
SMS_DRY_RUN=false

# ربات معاملاتی: keyId:secret   (secret = openssl rand -hex 32)
BOT_API_KEYS=

# پراکسی خروجی برای TronGrid و تلگرام (سرور ایران)
OUTBOUND_PROXY_URL=

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

USDT_TRC20_ADDRESS=
TRONGRID_BASE_URL=https://api.trongrid.io
TRONGRID_API_KEY=
USDT_PAYMENT_TTL_MIN=60

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
TELEGRAM_API_BASE=https://api.telegram.org

PERFORMANCE_RISK_PCT=0.5

# میرور npm هنگام build (اختیاری، برای سرور ایران)
