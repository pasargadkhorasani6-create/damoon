# nginx این فایل را با envsubst پردازش می‌کند (متغیر DOMAIN)

limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=general:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=perip:10m;

upstream nextjs {
  server app:3000;
  keepalive 32;
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      '';
}

server {
  listen 80;
  server_name ${DOMAIN} www.${DOMAIN};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  location / {
    return 301 https://${DOMAIN}$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  client_max_body_size 1m;
  server_tokens off;
  limit_conn perip 50;
  limit_req_status 429;
  limit_conn_status 429;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  # برنامه IP کاربر را فقط از این هدر می‌خواند؛ مقدار ارسالی کاربر بازنویسی می‌شود
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Connection "";

  # فید لحظه‌ای (SSE): بدون بافر و با timeout طولانی
  location = /api/signals/stream {
    proxy_pass http://nextjs;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    chunked_transfer_encoding on;
  }

  # API ربات (علاوه بر rate limit داخلی برنامه)
  location /api/bot/ {
    limit_req zone=api burst=40 nodelay;
    proxy_pass http://nextjs;
  }

  location ~ ^/(login|register|forgot-password) {
    limit_req zone=auth burst=20 nodelay;
    proxy_pass http://nextjs;
  }

  location /_next/static/ {
    proxy_pass http://nextjs;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    limit_req zone=general burst=60 nodelay;
    proxy_pass http://nextjs;
  }
}
