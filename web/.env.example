# ---------- عمومی ----------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=دامون

# ---------- دیتابیس و Redis ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/damoon
REDIS_URL=redis://localhost:6379/0

# ---------- امنیت ----------
# با `openssl rand -hex 32` بسازید
SESSION_SECRET=change-me-to-a-long-random-hex-string-of-64-chars-000000000000
OTP_PEPPER=change-me-another-long-random-hex-string-0000000000000000000000

# ---------- پیامک (ملی پیامک) ----------
# کلید کنسول از پنل ملی پیامک > توسعه‌دهندگان
MELIPAYAMAK_CONSOLE_KEY=
# شناسه‌ی الگوی خدماتی (پترن) با متغیر {0} برای کد. اگر خالی باشد از ارسال ساده با شماره‌ی FROM استفاده می‌شود
MELIPAYAMAK_BODY_ID=
MELIPAYAMAK_FROM=
# در توسعه: true = کد OTP فقط در لاگ سرور چاپ می‌شود
SMS_DRY_RUN=true
