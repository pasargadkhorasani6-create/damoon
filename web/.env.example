# ---------- عمومی ----------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=دامون

# ---------- دیتابیس و Redis ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/damoon
REDIS_URL=redis://localhost:6379/0

# ---------- امنیت ----------
# با `openssl rand -hex 32` بسازید
SESSION_SECRET=change-me-to-a-long-random-hex-string-of-64-chars-000000000000
OTP_PEPPER=change-me-another-long-random-hex-string-0000000000000000000000

# ---------- پیامک (ملی پیامک) ----------
# کلید کنسول از پنل ملی پیامک > توسعه‌دهندگان
MELIPAYAMAK_CONSOLE_KEY=
# شناسه‌ی الگوی خدماتی (پترن) با متغیر {0} برای کد. اگر خالی باشد از ارسال ساده با شماره‌ی FROM استفاده می‌شود
MELIPAYAMAK_BODY_ID=
MELIPAYAMAK_FROM=
# در توسعه: true = کد OTP فقط در لاگ سرور چاپ می‌شود
SMS_DRY_RUN=true

# ---------- API ربات معاملاتی ----------
# قالب: keyId:secret  (چند کلید با کاما). secret حداقل ۳۲ کاراکتر؛ با `openssl rand -hex 32` بسازید
BOT_API_KEYS=bot1:change-me-bot-secret-at-least-32-characters-long-000000

# ---------- پراکسی خروجی (سرور ایران) ----------
# TronGrid و Telegram از سرور ایران در دسترس نیستند. یک پراکسی HTTP(S) روی سرور خارج بدهید، مثلاً:
# OUTBOUND_PROXY_URL=http://user:pass@1.2.3.4:3128
OUTBOUND_PROXY_URL=

# ---------- زرین‌پال ----------
ZARINPAL_MERCHANT_ID=
# true = محیط آزمایشی sandbox.zarinpal.com
ZARINPAL_SANDBOX=true

# ---------- پرداخت تتر (USDT - شبکه TRC20) ----------
# آدرس کیف پول TRC20 خودتان (با T شروع می‌شود)
USDT_TRC20_ADDRESS=
TRONGRID_BASE_URL=https://api.trongrid.io
# کلید رایگان از trongrid.io (اختیاری ولی توصیه‌شده)
TRONGRID_API_KEY=
# مهلت پرداخت تتر به دقیقه
USDT_PAYMENT_TTL_MIN=60

# ---------- تلگرام ----------
# توکن از @BotFather
TELEGRAM_BOT_TOKEN=
# نام کاربری ربات بدون @
TELEGRAM_BOT_USERNAME=
# شناسه‌ی عددی کانال خصوصی (ربات باید ادمین کانال با دسترسی دعوت/حذف کاربر باشد)
TELEGRAM_CHANNEL_ID=
# پیش‌فرض api.telegram.org؛ روی سرور ایران یا OUTBOUND_PROXY_URL را تنظیم کنید یا یک relay بگذارید
TELEGRAM_API_BASE=https://api.telegram.org
