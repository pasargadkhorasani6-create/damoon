generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET_PASSWORD
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String    @unique
  passwordHash String
  role         Role      @default(USER)
  bannedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  subscriptions Subscription[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  // داده‌ی موقت ثبت‌نام (نام، ایمیل، هش رمز) تا پس از تأیید کد
  payload    Json?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}

// ---------------------------------------------------------------- سیگنال‌ها

enum Direction {
  BUY
  SELL
}

enum OrderType {
  MARKET
  STOP
  LIMIT
}

enum SignalStatus {
  PENDING // سفارش شرطی ثبت شده، هنوز فعال نشده
  ACTIVE // سفارش فعال شده (پوزیشن باز)
  TP_HIT // بسته‌شده با حد سود
  SL_HIT // بسته‌شده با حد ضرر
  CLOSED // بسته‌شده دستی/سایر
  CANCELED // سفارش شرطی فعال نشد یا لغو شد
}

model Signal {
  id                String       @id @default(cuid())
  // شناسه‌ی ربات (مثلاً شماره‌حساب-تیکت)؛ ارسال تکراری idempotent است
  externalId        String       @unique
  source            String
  symbol            String
  direction         Direction
  orderType         OrderType
  timeframe         String?
  digits            Int          @default(5)
  entry             Float
  stopLoss          Float
  takeProfit        Float?
  initialStopLoss   Float
  initialTakeProfit Float?
  status            SignalStatus @default(PENDING)
  signalAt          DateTime
  fillPrice         Float?
  activatedAt       DateTime?
  exitPrice         Float?
  closedAt          DateTime?
  // نتیجه بر حسب R، فقط توسط سرور از قیمت‌های گزارش‌شده‌ی ربات محاسبه می‌شود
  resultR           Float?
  cancelReason      String?
  comment           String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  events SignalEvent[]

  @@index([status])
  @@index([signalAt])
  @@index([closedAt])
}

model SignalEvent {
  id        String   @id @default(cuid())
  signalId  String
  signal    Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([signalId, createdAt])
}

// ---------------------------------------------------------------- اشتراک

enum SubscriptionSource {
  PAYMENT
  ADMIN
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planSlug  String
  startsAt  DateTime
  endsAt    DateTime
  source    SubscriptionSource
  // در صورت لغو توسط ادمین
  revokedAt DateTime?
  note      String?
  createdAt DateTime           @default(now())

  @@index([userId, endsAt])
  @@index([endsAt])
}
